{
  "name": "odyssey",
  "version": "1.0.0",
  "description": "",
  "author": "nguyenthanhduyofficial",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "db:generate": "turbo run generate --filter @odyssey/database",
    "db:migrate": "turbo run migrate --filter @odyssey/database",
    "db:push": "turbo run push --filter @odyssey/database",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "generate": "turbo run generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@odyssey/eslint-config": "workspace:*",
    "@odyssey/typescript-config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "plop": "^4.0.5",
    "prettier": "^3.9.6",
    "turbo": "^2.9.6",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.7.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
